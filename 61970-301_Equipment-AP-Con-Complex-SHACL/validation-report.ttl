<http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#ConductingEquipment.BaseVoltage-usage>
  a sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "C:301:EQ:ConductingEquipment.BaseVoltage:usage";
  sh:description "Use only when there is no voltage level container used and only one base voltage applies.  For example, not used for transformers.";
  sh:order 3;
  sh:group <http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#EQ301UMLvarious>;
  sh:path <https://cim.ucaiug.io/ns#Equipment.EquipmentContainer>;
  sh:sparql <http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#ConductingEquipment.BaseVoltage-usageSparql> .

<http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#ConductingEquipment.BaseVoltage-usageSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT $this ?value
			WHERE {
        $this $PATH ?value .
        #?value rdf:type ?type .
        ?value rdf:type cim:VoltageLevel .
        $this rdf:type ?condeqtype .
        BIND(EXISTS{$this cim:ConductingEquipment.BaseVoltage ?basevoltage} AS ?hasbv).
        #$this cim:ConductingEquipment.BaseVoltage ?basevoltage .
        #FILTER (!isLiteral(?basevoltage) && ?type=cim:VoltageLevel && ?condeqtype!=cim:ACLineSegment && ?condeqtype!=cim:EquivalentBranch && ?condeqtype!=cim:SeriesCompensator) .
        FILTER (?hasbv=true && ?condeqtype!=cim:ACLineSegment && ?condeqtype!=cim:EquivalentBranch && ?condeqtype!=cim:SeriesCompensator && ?condeqtype!=cim:Equipment) .        
			}""";
  sh:message "The association ConductingEquipment.BaseVoltage is defined for a ConductingEquipment contained in a VoltageLevel.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://cim.ucaiug.io/ns#> sh:declare [
      sh:prefix "cim";
      sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI
    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "eu";
      sh:namespace "https://cim.ucaiug.io/ns/eu#"^^xsd:anyURI
    ] .

<http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#ReactiveCapabilityCurve-curveYvalues>
  a sh:NodeShape;
  sh:targetClass <https://cim.ucaiug.io/ns#CurveData>;
  sh:message "CurveData associated with a ReactiveCapabilityCurve does not have both .y1value and .y2value defined.";
  sh:severity sh:Violation;
  sh:and ([ a sh:PropertyShape;
        sh:path <https://cim.ucaiug.io/ns#CurveData.y1value>;
        sh:minCount 1;
        sh:maxCount 1
      ] [ a sh:PropertyShape;
        sh:path <https://cim.ucaiug.io/ns#CurveData.y2value>;
        sh:minCount 1;
        sh:maxCount 1
      ]) .
