<http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#ACDCConverter.PccTerminal-valueType>
  a sh:PropertyShape;
  sh:message "The terminal is not a terminal of a PowerTransformer or a Switch.";
  sh:severity sh:Warning;
  sh:name "C:301:EQ:ACDCConverter.PccTerminal:valueType";
  sh:description "It is typically the terminal on the power transformer (or switch) closest to the AC network.";
  sh:order 1;
  sh:group <http://iec.ch/TC57/ns/CIM/Equipment-EU/constraints/IEC61970-301/3.0#EQ301UMLvarious>;
  sh:path _:3854140dc48fcc60;
