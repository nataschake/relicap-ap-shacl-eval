<http://iec.ch/TC57/ns/CIM/All-EU/constraints/IEC61970-600-1/3.0#All-GENC1> a sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "C:600:ALL:NA:GENC1";
  sh:description "All IdentifiedObject-s shall have a persistent and globally unique identifier (Master Resource Identifier - mRID).";
  sh:order 2;
  sh:group <http://iec.ch/TC57/ns/CIM/All-EU/constraints/IEC61970-600-1/3.0#All6001Group>;
  sh:path rdf:type;
  sh:sparql <http://iec.ch/TC57/ns/CIM/All-EU/constraints/IEC61970-600-1/3.0#All-GENC1Sparql> .

<http://iec.ch/TC57/ns/CIM/All-EU/constraints/IEC61970-600-1/3.0#All-GENC1Sparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this (COUNT(?value) AS ?counts) ?value
			WHERE {
          ?value rdf:type ?o.
          FILTER(?o!=cim:Equipment).
			}
      GROUP BY $this ?value
      HAVING(?counts>1)
      """;
  sh:message "Not an unique identifier.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://cim.ucaiug.io/ns#> sh:declare [
      sh:prefix "cim";
      sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI
    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "xsd";
      sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI
    ], [
      sh:prefix "eu";
      sh:namespace "https://cim.ucaiug.io/ns/eu#"^^xsd:anyURI
    ] .
