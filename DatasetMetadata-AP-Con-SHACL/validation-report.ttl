  sh:group <https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#LanguageTagGroup>;
  sh:path <http://www.w3.org/ns/adms#versionNotes>;
  sh:sparql <https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#versionNotes.langTag-presenceSparql> .

<https://ap-con.cim4.eu/DatasetMetadata-Simple/3.0#versionNotes.langTag-presenceSparql>
  a sh:SPARQLConstraint;
  sh:select """
	      SELECT $this ?value 
        WHERE {
		$this $PATH ?value .

        FILTER (lang(?value)!=\"en\" ).
        }""";
  sh:message "Language tag is not declared.{?value}";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

