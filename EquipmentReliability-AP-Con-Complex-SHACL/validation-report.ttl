@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf4j: <http://rdf4j.org/schema/rdf4j#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rsx: <http://rdf4j.org/shacl-extensions#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a sh:ValidationReport;
  sh:conforms false;
  rdf4j:truncated false;
  sh:result [ a sh:ValidationResult;
      sh:focusNode <urn:uuid:c31ae69b-423d-47c0-bacc-083d64e34d4a>;
      rsx:shapesGraph rdf4j:nil;
      sh:resultPath rdf:type;
      sh:sourceConstraint <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associationsSparql>;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent;
      sh:resultSeverity sh:Violation;
      sh:resultMessage "Circuit is not associated with either Equipment or Terminal.";
      sh:sourceShape <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associations>
    ], [ a sh:ValidationResult;
      sh:focusNode <urn:uuid:cef9011e-3753-453b-93bd-fb36eb3daac1>;
      rsx:shapesGraph rdf4j:nil;
      sh:resultPath rdf:type;
      sh:sourceConstraint <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associationsSparql>;
      sh:sourceConstraintComponent sh:SPARQLConstraintComponent;
      sh:resultSeverity sh:Violation;
      sh:resultMessage "Circuit is not associated with either Equipment or Terminal.";
      sh:sourceShape <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associations>
    ] .

<https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associations> a sh:PropertyShape;
  sh:severity sh:Violation;
  sh:name "C:NC:ER:Circuit:associations";
  sh:description "The Circuit shall be associated with either Equipment or Terminal.";
  sh:order 4;
  sh:group <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#ERgroup>;
  sh:path rdf:type;
  sh:sparql <https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associationsSparql> .

<https://ap-con.cim4.eu/EquipmentReliability-Complex/2.4#Circuit-associationsSparql>
  a sh:SPARQLConstraint;
  sh:select """
			SELECT  $this  
			WHERE {      
       
		BIND(EXISTS{$this nc:Equipment.Circuit ?o1} AS ?ce).
		BIND(EXISTS{$this nc:Circuit.IdentifyingTerminal ?o2} AS ?ct).
        FILTER (?ce=false && ?ct=false).
			}""";
  sh:message "Circuit is not associated with either Equipment or Terminal.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .

<https://cim.ucaiug.io/ns#> sh:declare [
      sh:prefix "cim";
      sh:namespace "https://cim.ucaiug.io/ns#"^^xsd:anyURI
    ], [
      sh:prefix "cim16";
      sh:namespace "http://iec.ch/TC57/2013/CIM-schema-cim16#"^^xsd:anyURI
    ], [
      sh:prefix "nc";
      sh:namespace "https://cim4.eu/ns/nc#"^^xsd:anyURI
    ], [
      sh:prefix "rdf";
      sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI
    ], [
      sh:prefix "cim17";
      sh:namespace "http://iec.ch/TC57/CIM100#"^^xsd:anyURI
    ] .
