<https://ap-con.cim4.eu/ClassCount-Complex/2.5#ClassCount-property> a sh:PropertyShape;
  sh:severity sh:Info;
  sh:name "ClassCount";
  sh:description "Counts instance of classes present in the data graph.";
  sh:order 1;
  sh:group <https://ap-con.cim4.eu/ClassCount-Complex/2.5#ClassesCountGroup>;
  sh:path rdf:type;
  sh:sparql <https://ap-con.cim4.eu/ClassCount-Complex/2.5#ClassCount-propertySparql> .

<https://ap-con.cim4.eu/ClassCount-Complex/2.5#ClassCount-propertySparql> a sh:SPARQLConstraint;
  sh:select """ 
            SELECT $this ?class (COUNT(?instance) AS ?value)
            WHERE {
                    ?instance rdf:type ?class .
                   }
            GROUP BY $this ?class
             """;
  sh:message "The class {?class} appears {?value} times in the data graph.";
  sh:prefixes <https://cim.ucaiug.io/ns#> .
