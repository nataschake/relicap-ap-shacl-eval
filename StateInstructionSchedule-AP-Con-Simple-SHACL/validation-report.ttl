<https://common-constraints.eu/ClassCount-property> a sh:PropertyShape;
  sh:severity sh:Info;
  sh:name "ClassCount";
  sh:description "Counts instance of classes present in the data graph.";
  sh:order 1;
  sh:group <https://common-constraints.eu/ClassesCountGroup>;
  sh:path rdf:type;
  sh:sparql <https://common-constraints.eu/ClassCount-propertySparql> .

<https://common-constraints.eu/ClassCount-propertySparql> a sh:SPARQLConstraint;
  sh:select """ 
            SELECT $this ?class (COUNT(?instance) AS ?value)
            WHERE {
                    ?instance rdf:type ?class .
                   }
            GROUP BY $this ?class
             """;
  sh:message "The class {?class} appears {?value} times in the data graph.";
  sh:prefixes <https://common-constraints.eu/> .

